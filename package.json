{
  "name": "recall",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names web,api --prefix-colors cyan,magenta \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "node --env-file-if-exists=.env --watch server/src/index.ts",
    "start:server": "node --env-file-if-exists=.env server/src/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "predev": "node scripts/prepare-assets.mjs",
    "prebuild": "node scripts/prepare-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "eval:segmentation": "node --env-file-if-exists=.env server/src/features/lecture/segmentation/eval.ts",
    "eval:lecture": "node --env-file-if-exists=.env server/src/features/lecture/eval.ts",
    "extract:slides": "node scripts/extract-slide-pages.mjs",
    "test": "node --test",
    "test:e2e": "playwright test",
    "prepare:reading": "node scripts/prepare-reading.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.1",
    "fastify": "5.12.7",
    "katex": "0.19.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-pdf": "^11.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "10.0.6",
    "typescript": "7.0.2",
    "vite": "7.3.8"
  }
}
