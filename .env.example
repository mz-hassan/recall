# Copy to .env for local overrides. .env is git-ignored; never commit real keys.
# These are read by the server only. Do not prefix them with VITE_.

HOST=127.0.0.1
PORT=8787

# fixture (default, no network) | deepseek | gemini
LLM_PROVIDER=fixture
LLM_MODEL=

DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
