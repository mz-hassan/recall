# Copy to .env (git-ignored). Credentials are server-only; never use VITE_ for keys.
HOST=127.0.0.1
# Port of the shared API; the Vite proxy reads the same value. (Renamed from PORT: rename it in your .env.)
API_PORT=3001

# Select gemini, deepseek, or fixture for all AI features. Fixture does not generate graph data.
LLM_PROVIDER=fixture
# Optional. Defaults: gemini-4-hydrogen for Gemini, deepseek-flash for DeepSeek.
LLM_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# CS50 local microphone recognition needs no API key or extra .env values.
# Install with: powershell -ExecutionPolicy Bypass -File scripts/install-speech.ps1

# Only the knowledge graph requires MongoDB. Live lecture remains available without it.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=recall

# Optional production hosting. Run npm run build, then npm start.
# APP_ORIGIN=https://recall.example.edu
# TLS_CERT_FILE=/path/to/fullchain.pem
# TLS_KEY_FILE=/path/to/privkey.pem
# If a TLS reverse proxy runs on this host instead, bind HOST to loopback:
# TRUST_LOOPBACK_PROXY=1
# STAFF_INVITE_CODE=your-private-invite
