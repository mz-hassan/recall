# Template only: copy to .env (git-ignored) and put real values there. Never put a key in this file.
# These are read by the server only. Do not prefix them with VITE_.

HOST=127.0.0.1
PORT=8787

# fixture (default, offline, no key) | deepseek | gemini
LLM_PROVIDER=fixture
# For deepseek: deepseek-flash (served by DeepSeek-V4.1-Flash-1017) or deepseek-v4-pro
LLM_MODEL=

# Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
