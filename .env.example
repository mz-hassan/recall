# Copy to .env (git-ignored). Credentials are server-only; never use VITE_ for keys.
HOST=127.0.0.1
# Port of the shared API; the Vite proxy reads the same value. (Renamed from PORT: rename it in your .env.)
API_PORT=3001

# Both live lecture and graph use these DeepSeek settings.
# Set fixture explicitly for offline live-lecture demos/tests; it does not generate graph data.
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Only the knowledge graph requires MongoDB. Live lecture remains available without it.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=recall
